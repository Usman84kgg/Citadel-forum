// ==========================================================
// CITADEL — Database Schema
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================================
// 1. IDENTITY & ACCESS
// ==========================================================

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  email             String    @unique
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  passwordHash      String
  displayName       String?
  avatarUrl         String?
  coverUrl          String?
  bio               String?
  website           String?
  timezone          String    @default("UTC")
  locale            String    @default("ru")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastActiveAt      DateTime?
  forceLogoutAt     DateTime?
  restrictedUntil   DateTime?

  security          UserSecurity?
  sessions          Session[]
  roles             UserRole[]
  accounts          Account[]
  threads           Thread[]
  posts             Post[]
  listings          Listing[]
  dealsAsBuyer      Deal[]              @relation("Buyer")
  dealsAsSeller     Deal[]              @relation("Seller")
  reviews           Review[]
  reputation        UserReputation?
  conversations     ConversationParticipant[]
  messages          Message[]
  notifications     Notification[]
  tickets           Ticket[]
  reports           Report[]
  moderationActions ModerationAction[]
  auditLogs         AuditLog[]
}

model UserSecurity {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])

  totpSecret      String?   // encrypted
  totpEnabled     Boolean   @default(false)
  backupCodes     String?   // encrypted JSON
  walletPin       String?   // hashed
  pgpPublicKey    String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Session {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])

  refreshTokenHash String
  deviceName      String?
  deviceType      String?
  ipAddress       String?
  userAgent       String?
  location        String?
  lastUsedAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  createdAt       DateTime  @default(now())
}

model Role {
  id              String    @id @default(cuid())
  name            String    @unique
  level           Int
  isStaff         Boolean   @default(false)
  isDefault       Boolean   @default(false)

  users           UserRole[]
  permissions     RolePermission[]
}

model Permission {
  id              String    @id @default(cuid())
  key             String    @unique
  group           String
  description     String?

  roles           RolePermission[]
}

model RolePermission {
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  permissionId    String
  permission      Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  grantedBy       String?
  grantedAt       DateTime  @default(now())
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
}

model Invite {
  id              String    @id @default(cuid())
  code            String    @unique
  createdBy       String
  usedBy          String?
  maxUses         Int       @default(1)
  useCount        Int       @default(0)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
}

model Ban {
  id              String    @id @default(cuid())
  userId          String
  reason          String
  scope           String    // full, forum, market, escrow, messaging
  bannedBy        String
  startsAt        DateTime  @default(now())
  endsAt          DateTime?
  isActive        Boolean   @default(true)
  revokedBy       String?
  revokedAt       DateTime?

  createdAt       DateTime  @default(now())
}

model LoginAttempt {
  id              String    @id @default(cuid())
  email           String
  ipAddress       String?
  success         Boolean
  userAgent       String?
  createdAt       DateTime  @default(now())
}// ==========================================================
// 2. FORUM
// ==========================================================

model ForumCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  color       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)

  forums      Forum[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Forum {
  id              String    @id @default(cuid())
  categoryId      String
  category        ForumCategory @relation(fields: [categoryId], references: [id])
  name            String
  slug            String    @unique
  description     String?
  icon            String?
  type            String    @default("discussion") // discussion, marketplace, announcements
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  isVip           Boolean   @default(false)
  threadCount     Int       @default(0)
  postCount       Int       @default(0)
  lastPostId      String?

  permissions     ForumPermission[]
  threads         Thread[]
  subscriptions   ForumSubscription[]
  readMarkers     ForumReadMarker[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ForumPermission {
  id              String    @id @default(cuid())
  forumId         String
  forum           Forum     @relation(fields: [forumId], references: [id])
  roleId          String?
  minimumRoleLevel Int?
  canView         Boolean   @default(true)
  canCreateThread Boolean   @default(false)
  canReply        Boolean   @default(false)
}

model Thread {
  id              String    @id @default(cuid())
  forumId         String
  forum           Forum     @relation(fields: [forumId], references: [id])
  authorId        String
  author          User      @relation(fields: [authorId], references: [id])
  title           String
  slug            String
  content         String
  type            String    @default("discussion") // discussion, poll, listing, deal, question
  isPinned        Boolean   @default(false)
  isLocked        Boolean   @default(false)
  isHidden        Boolean   @default(false)
  viewCount       Int       @default(0)
  postCount       Int       @default(0)
  lastPostId      String?
  lastPostAt      DateTime?
  prefixId        String?

  prefix          ThreadPrefix? @relation(fields: [prefixId], references: [id])
  posts           Post[]
  tags            ThreadTag[]
  poll            Poll?
  subscriptions   ThreadSubscription[]
  readTrackers    ThreadRead[]
  reports         Report[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([forumId, isPinned, lastPostAt])
  @@index([authorId])
}

model ThreadPrefix {
  id              String    @id @default(cuid())
  name            String
  color           String?
  icon            String?

  threads         Thread[]
}

model Tag {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  color           String?

  threads         ThreadTag[]
}

model ThreadTag {
  threadId        String
  thread          Thread    @relation(fields: [threadId], references: [id])
  tagId           String
  tag             Tag       @relation(fields: [tagId], references: [id])

  @@id([threadId, tagId])
}

model Post {
  id              String    @id @default(cuid())
  threadId        String
  thread          Thread    @relation(fields: [threadId], references: [id])
  authorId        String
  author          User      @relation(fields: [authorId], references: [id])
  parentPostId    String?
  parentPost      Post?     @relation("PostReplies", fields: [parentPostId], references: [id])
  replies         Post[]    @relation("PostReplies")
  content         String
  isHidden        Boolean   @default(false)
  isEdited        Boolean   @default(false)
  editCount       Int       @default(0)
  reactionCount   Int       @default(0)

  revisions       PostRevision[]
  reactions       Reaction[]
  reports         Report[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([threadId, createdAt])
  @@index([authorId])
}

model PostRevision {
  id              String    @id @default(cuid())
  postId          String
  post            Post      @relation(fields: [postId], references: [id])
  content         String
  editedAt        DateTime  @default(now())
  editReason      String?
}

model Reaction {
  id              String    @id @default(cuid())
  postId          String
  post            Post      @relation(fields: [postId], references: [id])
  userId          String
  type            String    // like, thanks, love, laugh, sad, angry
  createdAt       DateTime  @default(now())

  @@unique([postId, userId])
}

model Poll {
  id              String    @id @default(cuid())
  threadId        String    @unique
  thread          Thread    @relation(fields: [threadId], references: [id])
  question        String
  maxChoices      Int       @default(1)
  closesAt        DateTime?

  options         PollOption[]
}

model PollOption {
  id              String    @id @default(cuid())
  pollId          String
  poll            Poll      @relation(fields: [pollId], references: [id])
  text            String
  sortOrder       Int       @default(0)
  voteCount       Int       @default(0)

  votes           PollVote[]
}

model PollVote {
  id              String    @id @default(cuid())
  optionId        String
  option          PollOption @relation(fields: [optionId], references: [id])
  userId          String
  createdAt       DateTime  @default(now())

  @@unique([optionId, userId])
}

model ThreadSubscription {
  id              String    @id @default(cuid())
  threadId        String
  thread          Thread    @relation(fields: [threadId], references: [id])
  userId          String
  notifyEmail     Boolean   @default(false)
  notifyInApp     Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@unique([threadId, userId])
}

model ForumSubscription {
  id              String    @id @default(cuid())
  forumId         String
  forum           Forum     @relation(fields: [forumId], references: [id])
  userId          String
  createdAt       DateTime  @default(now())

  @@unique([forumId, userId])
}

model ThreadRead {
  id              String    @id @default(cuid())
  threadId        String
  thread          Thread    @relation(fields: [threadId], references: [id])
  userId          String
  lastReadPostId  String?
  readAt          DateTime  @default(now())

  @@unique([threadId, userId])
}

model ForumReadMarker {
  id              String    @id @default(cuid())
  forumId         String
  forum           Forum     @relation(fields: [forumId], references: [id])
  userId          String
  readAt          DateTime  @default(now())

  @@unique([forumId, userId])
}

// ==========================================================
// 3. MARKETPLACE
// ==========================================================

model ListingCategory {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  icon            String?
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  minReputation   Int       @default(0)

  listings        Listing[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Listing {
  id              String    @id @default(cuid())
  categoryId      String
  category        ListingCategory @relation(fields: [categoryId], references: [id])
  sellerId        String
  seller          User      @relation(fields: [sellerId], references: [id])
  title           String
  slug            String
  description     String
  type            String    @default("service") // service, product, digital, request
  price           BigInt?
  currency        String    @default("USD")
  status          String    @default("pending") // draft, pending, active, hidden, rejected
  isVerified      Boolean   @default(false)
  viewCount       Int       @default(0)
  orderCount      Int       @default(0)

  packages        ListingPackage[]
  media           ListingMedia[]
  attributes      Json?
  reports         Report[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([categoryId, status])
  @@index([sellerId])
}

model ListingPackage {
  id              String    @id @default(cuid())
  listingId       String
  listing         Listing   @relation(fields: [listingId], references: [id])
  name            String
  description     String?
  price           BigInt
  deliveryDays    Int?
  sortOrder       Int       @default(0)
}

model ListingMedia {
  id              String    @id @default(cuid())
  listingId       String
  listing         Listing   @relation(fields: [listingId], references: [id])
  mediaId         String
  media           Media     @relation(fields: [mediaId], references: [id])
  sortOrder       Int       @default(0)
  type            String    @default("image") // image, video, document
}

model ListingPromotion {
  id              String    @id @default(cuid())
  listingId       String
  type            String    // highlight, pin, featured
  startsAt        DateTime  @default(now())
  endsAt          DateTime
  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
}// ==========================================================
// 7. REPUTATION
// ==========================================================

model Review {
  id              String    @id @default(cuid())
  dealId          String    @unique
  deal            Deal      @relation(fields: [dealId], references: [id])
  reviewerId      String
  targetId        String
  rating          Int       // 1-5
  qualityRating   Int?
  speedRating     Int?
  communicationRating Int?
  comment         String?
  response        String?
  respondedAt     DateTime?
  isEdited        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([targetId])
}

model ReputationEvent {
  id              String    @id @default(cuid())
  userId          String
  source          String    // deal_completed, review_received, review_given, post_thanked, admin_adjustment, dispute_lost, warning
  delta           Int
  weight          Int       @default(1)
  referenceType   String?
  referenceId     String?
  metadata        Json?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
}

model UserReputation {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  score           Int       @default(0)
  positiveCount   Int       @default(0)
  negativeCount   Int       @default(0)
  dealCount       Int       @default(0)
  dealVolume      BigInt    @default(0)
  trustLevel      String    @default("new") // new, trusted, reliable, elite
  rank            Int?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Badge {
  id              String    @id @default(cuid())
  key             String    @unique
  name            String
  description     String?
  icon            String?
  color           String?
  category        String    @default("achievement")

  users           UserBadge[]
}

model UserBadge {
  id              String    @id @default(cuid())
  userId          String
  badgeId         String
  badge           Badge     @relation(fields: [badgeId], references: [id])
  awardedBy       String?
  awardedAt       DateTime  @default(now())
  metadata        Json?

  @@unique([userId, badgeId])
}

// ==========================================================
// 8. MESSAGING
// ==========================================================

model Conversation {
  id              String    @id @default(cuid())
  type            String    @default("direct") // direct, group, deal, support
  title           String?
  dealId          String?
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())

  participants    ConversationParticipant[]
  messages        Message[]
}

model ConversationParticipant {
  id              String    @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  lastReadAt      DateTime?
  isMuted         Boolean   @default(false)
  isArchived      Boolean   @default(false)
  joinedAt        DateTime  @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id              String    @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  senderId        String
  sender          User      @relation(fields: [senderId], references: [id])
  content         String?
  attachmentId    String?
  attachment      Media?    @relation(fields: [attachmentId], references: [id])
  isSystemMessage Boolean   @default(false)
  isDeleted       Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([conversationId, createdAt])
}

model UserBlock {
  id              String    @id @default(cuid())
  userId          String
  blockedUserId   String
  reason          String?
  createdAt       DateTime  @default(now())

  @@unique([userId, blockedUserId])
}

// ==========================================================
// 9. NOTIFICATIONS
// ==========================================================

model Notification {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  type            String    // deal_status, dispute, message, forum_reply, mention, system, security, marketing
  title           String
  body            String?
  link            String?
  data            Json?
  isRead          Boolean   @default(false)
  readAt          DateTime?
  priority        String    @default("normal") // low, normal, high, critical
  createdAt       DateTime  @default(now())

  @@index([userId, isRead, createdAt])
}

model NotificationPreference {
  id              String    @id @default(cuid())
  userId          String
  type            String
  channel         String    // in_app, email, push, telegram
  isEnabled       Boolean   @default(true)

  @@unique([userId, type, channel])
}

model Announcement {
  id              String    @id @default(cuid())
  title           String
  content         String?
  link            String?
  type            String    @default("info") // info, warning, success, maintenance
  targetRoles     Json?
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model PushSubscription {
  id              String    @id @default(cuid())
  userId          String
  endpoint        String
  p256dh          String
  auth            String
  createdAt       DateTime  @default(now())
}

// ==========================================================
// 10. SUPPORT
// ==========================================================

model Ticket {
  id              String    @id @default(cuid())
  number          Int       @unique @default(autoincrement())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  subject         String
  category        String    // billing, technical, escrow, abuse, verification, other
  status          String    @default("new") // new, open, pending_user, pending_staff, escalated, solved, closed
  priority        String    @default("normal") // low, normal, high, urgent
  assignedTo      String?
  dealId          String?
  slaFirstResponseAt DateTime?
  slaResolvedAt   DateTime?
  firstRespondedAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  satisfactionRating Int?

  messages        TicketMessage[]
  events          TicketEvent[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
  @@index([assignedTo, status])
}

model TicketMessage {
  id              String    @id @default(cuid())
  ticketId        String
  ticket          Ticket    @relation(fields: [ticketId], references: [id])
  senderId        String
  content         String
  isStaffNote     Boolean   @default(false)
  attachmentId    String?
  attachment      Media?    @relation(fields: [attachmentId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([ticketId, createdAt])
}

model TicketEvent {
  id              String    @id @default(cuid())
  ticketId        String
  ticket          Ticket    @relation(fields: [ticketId], references: [id])
  actorId         String
  type            String    // opened, assigned, responded, escalated, resolved, closed, reopened
  data            Json?
  createdAt       DateTime  @default(now())
}

model CannedResponse {
  id              String    @id @default(cuid())
  title           String
  content         String
  category        String?
  createdBy       String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==========================================================
// 11. MODERATION
// ==========================================================

model Report {
  id              String    @id @default(cuid())
  reporterId      String
  targetType      String    // post, thread, listing, user, message
  targetId        String
  reason          String
  description     String?
  status          String    @default("open") // open, investigating, resolved, dismissed
  assignedTo      String?
  resolution      String?
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([targetType, targetId])
}

model ModerationAction {
  id              String    @id @default(cuid())
  moderatorId     String
  moderator       User      @relation(fields: [moderatorId], references: [id])
  targetType      String
  targetId        String
  action          String    // hide, unhide, lock, unlock, move, delete, warn, mute, ban, unban
  reason          String?
  details         Json?
  reportId        String?
  expiresAt       DateTime?
  isReversible    Boolean   @default(true)
  reversedBy      String?
  reversedAt      DateTime?
  createdAt       DateTime  @default(now())
}

model Warning {
  id              String    @id @default(cuid())
  userId          String
  issuedBy        String
  reason          String
  points          Int       @default(1)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

model ContentFilter {
  id              String    @id @default(cuid())
  type            String    // banned_word, regex, link_whitelist, link_blacklist
  value           String
  isActive        Boolean   @default(true)
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==========================================================
// 12. AUDIT & SECURITY
// ==========================================================

model AuditLog {
  id              String    @id @default(cuid())
  actorId         String
  actor           User      @relation(fields: [actorId], references: [id])
  action          String
  targetType      String?
  targetId        String?
  details         Json?
  ipAddress       String?
  userAgent       String?
  requestId       String?
  createdAt       DateTime  @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model RiskEvent {
  id              String    @id @default(cuid())
  userId          String?
  type            String    // multi_account, rapid_login, unusual_activity, vpn_detected, high_risk_ip
  severity        String    @default("low") // low, medium, high, critical
  details         Json?
  ipAddress       String?
  fingerprint     String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
}

// ==========================================================
// 13. ADVERTISING
// ==========================================================

model AdCampaign {
  id              String    @id @default(cuid())
  title           String
  slot            String    // hero_banner, sidebar, between_sections, footer
  mediaId         String?
  media           Media?    @relation(fields: [mediaId], references: [id])
  mediaType       String    @default("image") // image, video
  linkUrl         String?
  targetAudience  Json?     // null = all, or role filter
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  priority        Int       @default(0)
  viewCount       Int       @default(0)
  clickCount      Int       @default(0)
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==========================================================
// 14. MEDIA & FILES
// ==========================================================

model Media {
  id              String    @id @default(cuid())
  fileName        String
  originalName    String
  mimeType        String
  size            BigInt
  url             String
  thumbnailUrl    String?
  width           Int?
  height          Int?
  duration        Int?      // video duration in seconds
  checksum        String?
  scanStatus      String    @default("pending") // pending, clean, infected, failed
  uploadedBy      String
  visibility      String    @default("public") // public, private, deal, dispute
  createdAt       DateTime  @default(now())

  listingMedia    ListingMedia[]
  disputeEvidence DisputeEvidence[]
  messageAttachments Message[]
  ticketAttachments TicketMessage[]
  adCampaigns     AdCampaign[]
}

// ==========================================================
// 15. PLATFORM
// ==========================================================

model Setting {
  id              String    @id @default(cuid())
  key             String    @unique
  value           Json
  description     String?
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FeatureFlag {
  id              String    @id @default(cuid())
  key             String    @unique
  description     String?
  isEnabled       Boolean   @default(false)
  targetRoles     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Page {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  content         String
  isActive        Boolean   @default(true)
  createdBy       String
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
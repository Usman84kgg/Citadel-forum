# ==========================================================
# CITADEL — ОБРАЗЕЦ ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# ==========================================================
#
# ЭТО ТОЛЬКО ОБРАЗЕЦ. Настоящие пароли и ключи сюда
# НИКОГДА не вписываются и в GitHub не попадают.
#
# Реальные значения вводятся в панели хостинга
# в разделе Environment Variables.
# ==========================================================

# --- ОСНОВНОЕ ---
NEXT_PUBLIC_SITE_URL="https://example.com"
NEXT_PUBLIC_ADMIN_URL="https://admin.example.com"
NODE_ENV="development"

# --- БАЗА ДАННЫХ (подключим позже) ---
DATABASE_URL=""
DIRECT_URL=""

# --- БЕЗОПАСНОСТЬ (подключим позже) ---
AUTH_SECRET=""
ENCRYPTION_KEY=""
CRON_SECRET=""

# --- ХРАНЕНИЕ ФАЙЛОВ (подключим позже) ---
STORAGE_PROVIDER="supabase"
STORAGE_URL=""
STORAGE_BUCKET="citadel"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- ПОЧТА (подключим позже) ---
MAIL_PROVIDER="resend"
MAIL_API_KEY=""
MAIL_FROM="CITADEL <noreply@example.com>"

# --- КЭШ (подключим позже) ---
REDIS_URL=""
REDIS_TOKEN=""

# --- ЗАЩИТА ОТ БОТОВ (подключим позже) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- ОШИБКИ (необязательно) ---
NEXT_PUBLIC_SENTRY_DSN=""

# ==========================================================
# ВАЖНО
#
# Адреса криптокошельков для пополнения ЗДЕСЬ НЕ ХРАНЯТСЯ.
# Они добавляются только через админ-панель и сохраняются
# в базе данных в зашифрованном виде.
# ==========================================================
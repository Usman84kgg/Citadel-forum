# ============================================
# CITADEL — файлы, которые НЕ попадают в Git
# ============================================

# --- Зависимости ---
node_modules/
.pnp
.pnp.js
.yarn/

# --- Сборка Next.js ---
.next/
out/
build/
dist/
next-env.d.ts

# --- СЕКРЕТЫ: пароли, ключи, адреса кошельков ---
# НИКОГДА не удаляй эти строки
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
secrets/
*.pem
*.key
*.p12
*.pfx
!.env.example

# --- Логи ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Кэш и временные файлы ---
.cache/
.temp/
.tmp/
*.tsbuildinfo
.eslintcache
.turbo/

# --- Тесты ---
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# --- Prisma (локальная база) ---
prisma/*.db
prisma/*.db-journal
prisma/dev.db*

# --- Хостинг ---
.vercel

# --- Редакторы и операционные системы ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ============================================
# РЕЗЕРВНЫЕ КОПИИ
# Структура папок хранится в Git.
# Сами файлы копий — НЕТ: в них персональные
# данные пользователей и адреса кошельков.
# ============================================
backup/database/*
!backup/database/.gitkeep
backup/uploads/*
!backup/uploads/.gitkeep
backup/settings/*
!backup/settings/.gitkeep

*.sql
*.sql.gz
*.dump
*.bak
*.tar.gz
!prisma/migrations/**/*.sql

# --- Крупные исходники дизайна ---
design/**/*.psd
design/**/*.ai
design/**/*.sketch
design/**/*.fig